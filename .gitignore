data/raw/
data/personal/
*.csv
*.json
!.github/**/*.json

# Logs
*.log
logs/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db

# Caché
.cache/
*.cache

# Tests
.coverage
htmlcov/
.pytest_cache/
